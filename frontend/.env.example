# Public frontend configuration. Copy to .env.local for local development.
# Do not add LiveKit, model-provider, or SIP credentials to this file.

# Public URL serving the Next.js API routes. Leave blank to use this frontend's
# own origin (recommended when the frontend and its /api/token route deploy together).
NEXT_PUBLIC_API_URL=

# Optional public LiveKit Cloud Sandbox / custom app configuration.
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
