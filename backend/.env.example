# Copy to backend/.env.local. Values are intentionally blank: never commit secrets.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MURF_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# Existing registered LiveKit agent name. It must match agent.py.
AGENT_NAME=my-agent

# LiveKit outbound SIP configuration (the SIP password stays in LiveKit).
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
OUTBOUND_SIP_URI=
OUTBOUND_CALL_TIMEOUT_SECONDS=60
MAX_CALL_DURATION_SECONDS=300
OUTBOUND_MAX_RETRIES=1
OUTBOUND_RETRY_DELAY_SECONDS=30
